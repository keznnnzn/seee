* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 20px;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
}

header {
    text-align: center;
    color: white;
    margin-bottom: 40px;
    padding: 20px;
}

header h1 {
    font-size: 2.5em;
    margin-bottom: 10px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

header p {
    font-size: 1.1em;
    opacity: 0.9;
}

.main-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 30px;
    margin-bottom: 40px;
}

/* Input Section */
.input-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    height: fit-content;
    position: sticky;
    top: 20px;
}

.input-section h2 {
    color: #333;
    margin-bottom: 20px;
    font-size: 1.5em;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 25px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: 600;
    color: #555;
    margin-bottom: 8px;
    font-size: 0.95em;
}

.form-group input,
.form-group select {
    padding: 12px;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    font-size: 1em;
    transition: all 0.3s ease;
    background-color: #f9f9f9;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: #667eea;
    background-color: white;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.btn-analyze {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1.1em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.btn-analyze:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
}

.btn-analyze:active {
    transform: translateY(0);
}

/* Results Section */
.results-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 40px;
}

.metric-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 25px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.2);
    transition: transform 0.3s ease;
}

.metric-card:hover {
    transform: translateY(-5px);
}

.metric-card h3 {
    font-size: 0.95em;
    margin-bottom: 15px;
    opacity: 0.95;
    font-weight: 600;
}

.metric-value {
    font-size: 2em;
    font-weight: bold;
    margin-bottom: 10px;
}

.metric-label {
    font-size: 0.85em;
    opacity: 0.85;
}

/* Charts */
.charts-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 40px;
}

.chart-wrapper {
    background: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #e0e0e0;
}

.chart-wrapper h4 {
    color: #333;
    margin-bottom: 15px;
    font-size: 1.1em;
}

.chart-wrapper canvas {
    max-height: 300px;
}

/* Recommendations */
.recommendations-box {
    background: #f0f7ff;
    border-left: 4px solid #667eea;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 30px;
}

.recommendations-box h3 {
    color: #667eea;
    margin-bottom: 15px;
    font-size: 1.2em;
}

.recommendations-box ul {
    list-style: none;
    padding-left: 0;
}

.recommendations-box li {
    padding: 10px 0;
    color: #555;
    border-bottom: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
}

.recommendations-box li:last-child {
    border-bottom: none;
}

.recommendations-box li:before {
    content: "✓";
    color: #667eea;
    font-weight: bold;
    margin-right: 10px;
    font-size: 1.2em;
}

/* Timeline */
.timeline-box {
    background: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #e0e0e0;
    margin-bottom: 30px;
}

.timeline-box h3 {
    color: #333;
    margin-bottom: 20px;
    font-size: 1.2em;
}

.timeline {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.timeline-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 15px;
    background: white;
    border-radius: 8px;
    border-left: 3px solid #667eea;
}

.timeline-time {
    font-weight: bold;
    color: #667eea;
    min-width: 80px;
    font-size: 1.1em;
}

.timeline-content {
    color: #555;
    font-size: 0.95em;
}

.timeline-item.optimal {
    background: #f0fff4;
    border-left-color: #48bb78;
}

.timeline-item.optimal .timeline-time {
    color: #48bb78;
}

/* Additional Metrics */
.additional-metrics {
    background: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #e0e0e0;
    margin-bottom: 30px;
}

.additional-metrics h3 {
    color: #333;
    margin-bottom: 20px;
    font-size: 1.2em;
}

.metrics-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.detail-item {
    background: white;
    padding: 15px;
    border-radius: 8px;
    border-left: 3px solid #667eea;
}

.detail-item label {
    display: block;
    font-weight: 600;
    color: #667eea;
    margin-bottom: 8px;
    font-size: 0.9em;
}

.detail-item span {
    display: block;
    font-size: 1.3em;
    font-weight: bold;
    color: #333;
}

/* Footer */
footer {
    text-align: center;
    color: white;
    padding: 20px;
    margin-top: 40px;
}

footer p {
    margin: 5px 0;
    opacity: 0.9;
    font-size: 0.9em;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .main-content {
        grid-template-columns: 1fr;
    }

    .input-section {
        position: static;
    }

    .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .charts-container {
        grid-template-columns: 1fr;
    }

    .metrics-details {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    header h1 {
        font-size: 1.8em;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .metrics-grid {
        grid-template-columns: 1fr;
    }

    .charts-container {
        grid-template-columns: 1fr;
    }

    .metrics-details {
        grid-template-columns: 1fr;
    }
}
